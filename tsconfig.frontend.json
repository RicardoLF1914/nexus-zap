{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Bundler",
    "rootDir": "./src/frontend",
    "outDir": "./public/js",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/frontend/**/*.ts"]
}